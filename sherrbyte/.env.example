# ─── App ──────────────────────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=INFO
RUN_SCHEDULER=true

# ─── Database (Supabase / Postgres + pgvector) ────────────────────────────
# DATABASE_URL is the asyncpg connection string. For Supabase, use the
# TRANSACTION POOLER URI (Supabase → Project Settings → Database → Connection
# string → "Transaction pooler"): IPv4-friendly and works from Docker/Render.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# For the optional fully-offline `local-db` compose profile instead, use:
#   postgresql://postgres:postgres@db:5432/sherrbyte
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Optional — only needed if you use Supabase Auth/Storage (supabase-py client).
SUPABASE_URL=
SUPABASE_KEY=

# ─── Redis (cache + ARQ queue + dedup set) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=30

# ─── AI providers (Gemini → Groq cascade) ─────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Collection ───────────────────────────────────────────────────────────
NEWSAPI_KEY=
COLLECT_INTERVAL_MIN=25

# ─── Recommender weights (score = α·content + β·collab + γ·freshness) ──────
REC_ALPHA=0.5
REC_BETA=0.3
REC_GAMMA=0.2
MMR_LAMBDA=0.7
FRESHNESS_HALFLIFE_HOURS=12

# ─── Markets (optional providers) ─────────────────────────────────────────
FINNHUB_KEY=
METALS_API_KEY=

# ─── Watermark (SGI / IT Rules 2026) ──────────────────────────────────────
WATERMARK_SECRET=change-me

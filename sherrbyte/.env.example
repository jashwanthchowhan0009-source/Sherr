# ─── App ──────────────────────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=INFO
RUN_SCHEDULER=true

# ─── Database (Supabase / Postgres + pgvector) ────────────────────────────
# DATABASE_URL is the asyncpg connection string. For Supabase, use the
# TRANSACTION POOLER URI (Supabase → Project Settings → Database → Connection
# string → "Transaction pooler"): IPv4-friendly and works from Docker/Render.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# NOTE: the app already makes the pooler (port 6543, pgbouncer transaction mode)
# safe in code — statement_cache_size=0 + unique prepared-statement names — and
# strips pgbouncer/SQLAlchemy-only query params (pgbouncer, prepared_statement_cache_size,
# statement_cache_size) from the URL, so you do NOT need to append them yourself.
# Keep ?sslmode=require. Direct (non-pooler) 5432 URLs also work.
# For the optional fully-offline `local-db` compose profile instead, use:
#   postgresql://postgres:postgres@db:5432/sherrbyte
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Optional — only needed if you use Supabase Auth/Storage (supabase-py client).
SUPABASE_URL=
SUPABASE_KEY=

# ─── Redis (cache + ARQ queue + dedup set) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=30

# ─── AI providers (Gemini → Groq cascade) ─────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
# Groq rate-limit guardrails (throttle below the free-tier TPM, back off on 429)
GROQ_TPM_LIMIT=12000
GROQ_MAX_CONCURRENCY=2
GROQ_MAX_RETRIES=5
GROQ_BACKOFF_BASE_SEC=1.0
GROQ_BACKOFF_MAX_SEC=30.0

# ─── Collection ───────────────────────────────────────────────────────────
NEWSAPI_KEY=
COLLECT_INTERVAL_MIN=25

# ─── Recommender weights (score = α·content + β·collab + γ·freshness) ──────
REC_ALPHA=0.5
REC_BETA=0.3
REC_GAMMA=0.2
MMR_LAMBDA=0.7
FRESHNESS_HALFLIFE_HOURS=12

# ─── Markets (optional providers) ─────────────────────────────────────────
FINNHUB_KEY=
METALS_API_KEY=

# ─── Watermark (SGI / IT Rules 2026) ──────────────────────────────────────
WATERMARK_SECRET=change-me
